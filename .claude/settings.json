{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python -m pytest:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(.venv/Scripts/ruff:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose build:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Read(./backups/**)",
      "Edit(./.env)",
      "Bash(./deploy.sh:*)",
      "Bash(sh deploy.sh:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
