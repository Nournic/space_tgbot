BOT_TOKEN=your_bot_token_here
DATABASE_PATH=data/space_trader.sqlite3
# Необязательно: фиксированный seed определяет ежедневные цены и события.
# Не меняйте его на работающем сервере — иначе цены текущего дня изменятся.
GAME_SEED=space-trader-1.0
LOG_LEVEL=INFO
# Необязательно: Telegram ID администраторов через запятую — им доступна /admin (в личке с ботом).
ADMIN_IDS=
